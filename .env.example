# ---------------------------------------------------------------------------
# Claims Intake Agent — local development environment
# Copy to .env before running: cp .env.example .env
# .env is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

# Application
APP_ENV=local

# LLM
LLM_MODE=mock                           # mock | bedrock
AWS_REGION=us-west-2
LLM_MODEL_DEFAULT=bedrock/<claude-sonnet-model-id>
LLM_MODEL_FAST=bedrock/<claude-haiku-model-id>

# Database
DATABASE_URL=postgresql+psycopg://claims:claims@postgres:5432/claims

# MCP tools server
MCP_URL=http://mcp-tools:8765/mcp

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=claims-intake-agent

# Business rules
MAX_VERIFY_ATTEMPTS=3
MAX_CLARIFY_TURNS=6

# Postgres container (used by docker-compose, not the application)
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_DB=claims
